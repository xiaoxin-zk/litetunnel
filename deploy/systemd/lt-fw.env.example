# LiteTunnel 防火墙 helper 配置
#
# 部署步骤：
#   1. cp lt-fw.env.example /etc/litetunnel/lt-fw.env
#   2. 生成随机 token 填进 LT_FW_TOKEN：
#        openssl rand -hex 32
#   3. cp lt-fw.service /etc/systemd/system/
#   4. systemctl daemon-reload && systemctl enable --now lt-fw
#   5. 把同一个 token 填进管理端「系统设置 → 端口与防火墙 → helper 访问令牌」
#
# 第 5 步的 token 必须与这里完全一致，否则面板会一直报
# 「无法连接宿主机 helper」。

# 监听地址。**必须**是回环地址——绑到 0.0.0.0 会让同网段的人
# 直接调用防火墙接口。程序启动时会校验并拒绝非回环地址。
LT_FW_ADDR=127.0.0.1:7849

# 访问令牌。至少 16 字符，建议 32 字节随机值的十六进制表示。
# 没有它的话，本机任何进程（包括被入侵的其他服务）都能改防火墙。
LT_FW_TOKEN=

# 保护端口：这些端口永远不允许被本 helper 关闭。
#
# 这是最后一道保险。务必包含：
#   - SSH 端口（默认 22，改了要跟着改）
#   - 面板自身的监听端口（默认 7848）
#   - frps 的端口（默认 7001；KCP 7002；dashboard 7500）
# 注意：面板设置里的默认保护列表会自动带上 LT_GATEWAY_PORT，
# 但 helper 自己这份是兜底，改了端口要同步。
LT_FW_PROTECTED_PORTS=22,7848,7001,7002,7500

# 隧道端口池范围。helper 只允许操作这个区间内的端口，
# 池外的端口一律拒绝——避免误伤服务器上其他业务。
# 留空或填 0 表示不限制（不建议）。
LT_FW_POOL_START=20000
LT_FW_POOL_END=30000

# 防火墙后端：auto / iptables / nftables / ufw / firewalld
#
# auto 会按 firewalld → ufw → nftables → iptables 的顺序探测，
# 优先高层工具：它们的状态与规则更容易被正确回读，而直接操作 iptables
# 在同时装了 firewalld/ufw 的主机上会产生冲突。
LT_FW_BACKEND=auto
