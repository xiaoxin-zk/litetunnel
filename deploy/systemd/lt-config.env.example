# LiteTunnel 域名与证书配置服务配置
#
# 部署步骤：
#   1. cp lt-config.env.example /etc/litetunnel/lt-config.env
#   2. 生成随机 token 填进 LT_CFG_TOKEN：
#        openssl rand -hex 32
#   3. 把 LT_CFG_DEPLOY_DIR / LT_CFG_ENV_FILE 改成本机实际路径
#   4. cp lt-config.service /etc/systemd/system/，并按注释改 ReadWritePaths
#   5. systemctl daemon-reload && systemctl enable --now lt-config
#   6. 把同一个地址与 token 填进管理后台「域名与证书 → 配置服务」两栏
#
# 第 6 步必须与这里完全一致，否则页面会一直报「无法连接宿主机配置服务」。

# 监听地址。**必须**是回环地址——绑到 0.0.0.0 等于把「重写 TLS 配置并重启
# 容器」的接口送给整个网段。程序启动时会校验并拒绝非回环地址。
LT_CFG_ADDR=127.0.0.1:7850

# 访问令牌。至少 16 字符，建议 32 字节随机值的十六进制表示。
LT_CFG_TOKEN=

# 部署目录：docker-compose.yml 与模板所在处（仓库里的 deploy/）。
LT_CFG_DEPLOY_DIR=/opt/litetunnel/deploy

# .env 路径。默认取部署目录的上一级，通常不需要显式写。
LT_CFG_ENV_FILE=/opt/litetunnel/.env

# docker-compose.yml 路径，默认取部署目录下的同名文件。
LT_CFG_COMPOSE_FILE=/opt/litetunnel/deploy/docker-compose.yml

# 校验用的 Caddy 镜像。留空则取 .env 里的 LT_CADDY_IMAGE（推荐留空：
# 校验器必须与运行时是同一个镜像，否则「配置能加载」这个结论不可信）。
# LT_CFG_CADDY_IMAGE=

# 校验用的 frps 镜像，与 compose 里的版本保持一致。
LT_CFG_FRPS_IMAGE=fatedier/frps:v0.71.0

# frps.toml 用 `frps verify` 校验。所用镜像没有该子命令时设为 false。
LT_CFG_VALIDATE_FRPS=true

# 是否允许重建容器。设为 false 时只渲染与校验，适合先演练一遍。
LT_CFG_APPLY=true

# DNS 检查走哪个解析服务器。留空用系统默认。
# 服务器自身的解析器被改坏时，检查结果会误导管理员去改本来就正确的记录。
# LT_CFG_DNS_SERVER=223.5.5.5
