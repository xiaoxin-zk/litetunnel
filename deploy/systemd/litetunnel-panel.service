[Unit]
Description=LiteTunnel panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=litetunnel
Group=litetunnel
WorkingDirectory=/opt/litetunnel
# 配置放 /etc，数据放 /var/lib，二进制目录只放程序本身，便于在线更新。
EnvironmentFile=-/etc/litetunnel/panel.env
Environment=LT_DATA_DIR=/var/lib/litetunnel
# 允许面板「立即更新」：下载新二进制、校验后原地替换并 exec 自身。
# 容器部署不要设置这一项（容器内替换会在重启后失效）。
Environment=LT_SELF_UPDATE=1
ExecStart=/opt/litetunnel/litetunnel-panel
Restart=always
RestartSec=3
LimitNOFILE=65535

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 只有这两处可写：数据目录与程序目录（更新时需要替换二进制）。
ReadWritePaths=/var/lib/litetunnel /opt/litetunnel

[Install]
WantedBy=multi-user.target
