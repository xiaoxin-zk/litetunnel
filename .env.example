# ============================================================
#  LiteTunnel 环境变量模板
#  复制为 .env 后填写真实值。.env 已被 .gitignore 忽略。
#  【重要】真实公网 IP / 域名 / 密钥只写在这里，禁止写进任何源码文件。
# ============================================================

# ---------- 基础 ----------
LT_ENV=production
LT_LOG_LEVEL=info

# ---------- 容器镜像 ----------
# 由 GitHub Actions 推送到 GHCR，格式：ghcr.io/<你的GitHub用户名>/litetunnel-panel:<tag>
LT_PANEL_IMAGE=ghcr.io/xiaoxin-zk/litetunnel-panel:latest

# ---------- 数据存储 ----------
# 默认 SQLite（纯 Go 实现，无需 CGO），单机场景足够
LT_DB_DRIVER=sqlite
LT_DB_DSN=./data/litetunnel.db
# 如需 PostgreSQL，改为：
# LT_DB_DRIVER=postgres
# LT_DB_DSN=host=127.0.0.1 user=litetunnel password=CHANGE_ME dbname=litetunnel port=5432 sslmode=disable TimeZone=Asia/Shanghai

# ---------- 用户控制台（对公网暴露）----------
# 直连部署时填 0.0.0.0:7848；Docker + Caddy 部署时填 127.0.0.1:7848，由 Caddy 转发
LT_USER_ADDR=0.0.0.0:7848
LT_USER_PORT=7848
# 用户控制台对外访问地址（Caddy 上绑定的域名，例如 https://panel.example.com）
#
# 生产环境**必填**：找回密码邮件里的重置链接要用它拼域名。
# 留空的话服务端不会从请求的 Host 推断（那样会被 Host 头投毒：攻击者伪造 Host
# 就能让链接指向他自己的域名，用户一点就把重置令牌交出去），而是直接不发这封信，
# 并在启动时拒绝启动（LT_ENV=production 时）。
LT_USER_PUBLIC_URL=

# ---------- 管理后台 ----------
# 管理后台与用户控制台共用同一端口，通过路径区分（单一公网入口）。
#
# 挂载路径。刻意不使用 /admin 这类扫描器字典里的高频词：
# 管理后台虽是公网可达的（安全由账号锁定 + 限流 + 双因素保证），
# 但换成自定义路径能挡掉绝大部分自动化探测流量。
# 规则：单层路径，3-64 个字符，仅允许字母/数字/-/_，不得占用 /api 等保留前缀。
# 前端使用相对资源路径与哈希路由，改这里无需重新构建镜像。
LT_ADMIN_PATH=/lt-console
#
# 可选：限制管理后台的来源网段。留空表示对公网开放，
# 此时安全性完全依赖「IP 限流 + 账号锁定 + 双因素认证」三层机制，
# 因此务必在首次登录后立即启用双因素认证。
# 示例：LT_ADMIN_ALLOW_CIDR=203.0.113.0/24,198.51.100.7
LT_ADMIN_ALLOW_CIDR=

# ---------- Caddy（自动 HTTPS）----------
# Let's Encrypt 通知邮箱
LT_ACME_EMAIL=

# Caddy 容器镜像。
# 官方镜像不含任何 DNS 插件，只够用在「仅裸域名证书」的部署上；一旦配置了
# LT_TUNNEL_DOMAIN，泛域名证书只能走 DNS Challenge，必须换成自行构建的镜像：
#
#   LT_CADDY_DNS_MODULES=cloudflare
#   docker compose --env-file .env -f deploy/docker-compose.yml build caddy
#   LT_CADDY_IMAGE=litetunnel-caddy:latest
#
# （构建前需先取消 deploy/docker-compose.yml 中 caddy.build 段的注释。）
LT_CADDY_IMAGE=caddy:2-alpine

# 构建自定义镜像时使用的基础镜像标签
LT_CADDY_VERSION=2

# 要编入镜像的 DNS 服务商插件，空格分隔（可多个）。
# 插件统一取自 github.com/caddy-dns/<名字>，名字即 Caddyfile 里 dns 指令的
# 第一个参数：cloudflare / alidns / dnspod / route53 ...
# 改完必须重新 build 并重建容器，否则 Caddy 会报 unrecognized directive: dns。
LT_CADDY_DNS_MODULES=

# 泛域名证书使用的 dns 指令名，需与上面的插件名一致（如 cloudflare）。
# 留空表示不使用泛域名，此时 LT_TUNNEL_DOMAIN 也必须留空——渲染脚本会校验：
# 泛域名证书没有 DNS Challenge 就签不下来，与其产出一份 Caddy 拒绝加载的
# 配置，不如在渲染阶段直接报错。
LT_CADDY_DNS_PROVIDER=

# 传给 dns 指令的参数（凭据）。留空则默认取 {env.LT_CADDY_DNS_CREDENTIAL}，
# 即用下面那个环境变量。需要两个参数的服务商（如 route53）在这里显式写
# "{env.X} {env.Y}"，并把额外变量补进 docker-compose.yml 的 caddy.environment。
LT_CADDY_DNS_ARGS=

# DNS 服务商凭据（API Token / Secret Key）。只经 compose 注入容器环境，
# 不会出现在 Caddyfile、日志或任何配置文件里。
LT_CADDY_DNS_CREDENTIAL=

# ---------- 安全密钥（务必修改，建议 32 位以上随机串）----------
# 生成方式：openssl rand -hex 32
LT_USER_JWT_SECRET=CHANGE_ME_user_jwt_secret
LT_ADMIN_JWT_SECRET=CHANGE_ME_admin_jwt_secret
# 用户 API Key 落库加密密钥（32 字节 hex）
LT_APIKEY_ENC_KEY=CHANGE_ME_32_bytes_hex_key

# 初始管理员账号（仅首次启动创建，登录后请立即修改密码）
LT_BOOTSTRAP_ADMIN_USER=admin
LT_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---------- 隧道网关（frps）----------
# 客户端连接使用的地址与端口，会下发给客户端
LT_GATEWAY_HOST=
LT_GATEWAY_PORT=7001
# KCP/QUIC 加速端口（UDP），用于游戏联机降低延迟
# 注意：与网关端口同为 7001 时，TCP 与 UDP 可共存，但为避免混淆这里用 7002
LT_KCP_PORT=7002
# frp 的 HTTP/HTTPS 隧道入口，仅监听本机，由 Caddy 按域名转发
LT_VHOST_HTTP_PORT=8081
LT_VHOST_HTTPS_PORT=8444
# frps 全局 token，需与 deploy/frps/frps.toml 中 auth.token 一致
LT_FRPS_TOKEN=CHANGE_ME_frps_token
# frps 管理接口（仅本机）
LT_FRPS_API_ADDR=127.0.0.1:7500
LT_FRPS_API_PORT=7500
LT_FRPS_API_USER=admin
LT_FRPS_API_PASSWORD=CHANGE_ME_frps_dashboard_password
# 允许调用服务端插件回调的来源网段（frp 插件协议不支持自定义鉴权头，改用来源白名单）
# 默认仅回环地址。若 frps 以容器方式部署在独立网络，请填写该容器的出口网段。
LT_FRPS_PLUGIN_ALLOW_CIDR=127.0.0.1/32,::1/128

# ---------- 隧道端口池 ----------
#
# 用户隧道的公网端口从这个区间里自动分配。
#
# 两个硬约束：
#   1. 下限不得低于 1024（禁止占用特权端口），程序启动时会校验
#   2. **上限不要超过 32767**——内核把 32768-60999 分配给出站连接做源端口
#      （net.ipv4.ip_local_port_range）。端口池与之重叠会导致 frps 偶发
#      绑定失败，表现为随机的「隧道建不起来」，极难排查。
#      想用满空间的话，上限就取 32767。
#
# 注意：改这里之后**必须重新渲染 deploy/frps/frps.toml 并重启 frps**，
# 因为 frps 的 allowPorts 是从这两个值生成的。只改这里会让面板分配出
# frps 拒绝的端口，表现为「面板说分配成功但隧道连不上」。
LT_PORT_RANGE_START=15000
LT_PORT_RANGE_END=32767
# 单用户可占用端口数上限（frps 层面的硬限制）
#
# 与分组的 max_ports 是两道独立限制，取更严的那个生效。
LT_MAX_PORTS_PER_USER=20

# ---------- 域名 ----------
# HTTP/HTTPS 隧道的域名，例如 tunnel.example.com
#
# 注意这里填**裸域名**，不要带 "*." 前缀：同一个值还会写进 frps 的
# subDomainHost，客户端用它拼出 <子域>.域名。Caddy 侧的站点地址由渲染
# 脚本自动加上 *. 前缀以申请泛域名证书。
#
# 需要配套：Caddy 镜像里编入 DNS 插件（LT_CADDY_DNS_MODULES + 自定义镜像）
# 并填写 LT_CADDY_DNS_PROVIDER，否则渲染会直接失败。
# 留空表示不启用 HTTP/HTTPS 隧道，此时 Caddyfile 里的泛域名段会被整段删除。
LT_TUNNEL_DOMAIN=

# HTTPS 隧道模式：
#   edge（默认）—— 证书留在 Caddy。Caddy 用泛域名证书在 443 上终止 TLS，
#                  再以 HTTP 转发给 vhostHTTPPort。本地网站继续用 HTTP，
#                  证书不发给客户端。
#   e2e         —— 证书留在本地网站。frps 在 LT_VHOST_HTTPS_PORT 上按 SNI 把
#                  原始 TLS 连接转给 frpc，Caddy 完全不参与，加密是端到端的。
#                  选它必须放行 LT_VHOST_HTTPS_PORT/TCP，并且让 HTTPS 隧道
#                  用该端口访问（443 由 Caddy 接管，会返回平台证书）。
#
# 两种模式都需要 LT_TUNNEL_DOMAIN 与 LT_CADDY_DNS_PROVIDER。
# 后台「域名与证书」页改的就是这一项与下面几项，改完由 lt-config 下发。
LT_HTTPS_TUNNEL_MODE=edge

# ---------- 反向代理信任 ----------
# 允许其转发头（X-Forwarded-For）生效的代理地址。默认为回环地址（反代同机）。
# 切勿填 0.0.0.0/0，否则客户端可伪造来源 IP 绕过限流与白名单。
LT_TRUSTED_PROXIES=127.0.0.1,::1

# ---------- 控制台前端产物 ----------
LT_USER_WEB_DIR=./web/user/dist
LT_ADMIN_WEB_DIR=./web/admin/dist

# ---------- 邮件服务（用于找回密码）----------
# 以 QQ 邮箱为例：
#   1. 登录 QQ 邮箱 → 设置 → 账户 → 开启「POP3/SMTP 服务」
#   2. 生成「授权码」——注意不是 QQ 登录密码
#   3. 把授权码填到 LT_SMTP_PASS
# 未配置时找回密码功能自动禁用，接口会明确提示用户联系管理员。
# 国内服务器 25 端口普遍被封，请使用 465(ssl) 或 587(starttls)。
LT_SMTP_HOST=
LT_SMTP_PORT=465
# 取值：ssl（465 隐式 TLS）/ starttls（587）/ none（明文，生产环境禁止）
LT_SMTP_TLS=ssl
LT_SMTP_USER=
LT_SMTP_PASS=
# 留空则回落到 LT_SMTP_USER，多数服务商要求二者一致
LT_SMTP_FROM=

# 站点名称，出现在邮件标题与正文中
LT_SITE_NAME=LiteTunnel

# ---------- 客户端分发 ----------
# 存放对外分发的客户端安装包目录，用户控制台会自动列出该目录下的文件
LT_CLIENT_DIST_DIR=./data/clients

# ---------- 流量统计 ----------
# 从 frps 拉取流量统计的间隔（秒）
LT_TRAFFIC_POLL_INTERVAL=30
