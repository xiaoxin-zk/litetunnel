# ============================================================
#  LiteTunnel 环境变量模板
#  复制为 .env 后填写真实值。.env 已被 .gitignore 忽略。
#  【重要】真实公网 IP / 域名 / 密钥只写在这里，禁止写进任何源码文件。
# ============================================================

# ---------- 基础 ----------
LT_ENV=production
LT_LOG_LEVEL=info

# ---------- 容器镜像 ----------
# 由 GitHub Actions 推送到 GHCR，格式：ghcr.io/<你的GitHub用户名>/litetunnel-panel:<tag>
LT_PANEL_IMAGE=ghcr.io/xiaoxin-zk/litetunnel-panel:latest

# ---------- 数据存储 ----------
# 默认 SQLite（纯 Go 实现，无需 CGO），单机场景足够
LT_DB_DRIVER=sqlite
LT_DB_DSN=./data/litetunnel.db
# 如需 PostgreSQL，改为：
# LT_DB_DRIVER=postgres
# LT_DB_DSN=host=127.0.0.1 user=litetunnel password=CHANGE_ME dbname=litetunnel port=5432 sslmode=disable TimeZone=Asia/Shanghai

# ---------- 用户控制台（对公网暴露）----------
# 直连部署时填 0.0.0.0:7848；Docker + Caddy 部署时填 127.0.0.1:7848，由 Caddy 转发
LT_USER_ADDR=0.0.0.0:7848
LT_USER_PORT=7848
# 用户控制台对外访问地址（Caddy 上绑定的域名，例如 https://panel.example.com）
LT_USER_PUBLIC_URL=

# ---------- 管理后台 ----------
# 管理后台与用户控制台共用同一端口，挂载在 /admin 路径下（单一公网入口）。
#
# 可选：限制管理后台的来源网段。留空表示对公网开放，
# 此时安全性完全依赖「IP 限流 + 账号锁定 + 双因素认证」三层机制，
# 因此务必在首次登录后立即启用双因素认证。
# 示例：LT_ADMIN_ALLOW_CIDR=203.0.113.0/24,198.51.100.7
LT_ADMIN_ALLOW_CIDR=

# ---------- Caddy（自动 HTTPS）----------
# Let's Encrypt 通知邮箱
LT_ACME_EMAIL=

# ---------- 安全密钥（务必修改，建议 32 位以上随机串）----------
# 生成方式：openssl rand -hex 32
LT_USER_JWT_SECRET=CHANGE_ME_user_jwt_secret
LT_ADMIN_JWT_SECRET=CHANGE_ME_admin_jwt_secret
# 用户 API Key 落库加密密钥（32 字节 hex）
LT_APIKEY_ENC_KEY=CHANGE_ME_32_bytes_hex_key

# 初始管理员账号（仅首次启动创建，登录后请立即修改密码）
LT_BOOTSTRAP_ADMIN_USER=admin
LT_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---------- 隧道网关（frps）----------
# 客户端连接使用的地址与端口，会下发给客户端
LT_GATEWAY_HOST=
LT_GATEWAY_PORT=7001
# KCP/QUIC 加速端口（UDP），用于游戏联机降低延迟
# 注意：与网关端口同为 7001 时，TCP 与 UDP 可共存，但为避免混淆这里用 7002
LT_KCP_PORT=7002
# frp 的 HTTP/HTTPS 隧道入口，仅监听本机，由 Caddy 按域名转发
LT_VHOST_HTTP_PORT=8081
LT_VHOST_HTTPS_PORT=8444
# frps 全局 token，需与 deploy/frps/frps.toml 中 auth.token 一致
LT_FRPS_TOKEN=CHANGE_ME_frps_token
# frps 管理接口（仅本机）
LT_FRPS_API_ADDR=127.0.0.1:7500
LT_FRPS_API_PORT=7500
LT_FRPS_API_USER=admin
LT_FRPS_API_PASSWORD=CHANGE_ME_frps_dashboard_password
# 允许调用服务端插件回调的来源网段（frp 插件协议不支持自定义鉴权头，改用来源白名单）
# 默认仅回环地址。若 frps 以容器方式部署在独立网络，请填写该容器的出口网段。
LT_FRPS_PLUGIN_ALLOW_CIDR=127.0.0.1/32,::1/128

# ---------- 隧道端口池 ----------
LT_PORT_RANGE_START=20000
LT_PORT_RANGE_END=30000
# 单用户可占用端口数上限
LT_MAX_PORTS_PER_USER=10

# ---------- 域名 ----------
# HTTP/HTTPS 隧道泛域名，例如 tunnel.example.com
LT_TUNNEL_DOMAIN=

# ---------- 反向代理信任 ----------
# 允许其转发头（X-Forwarded-For）生效的代理地址。默认为回环地址（反代同机）。
# 切勿填 0.0.0.0/0，否则客户端可伪造来源 IP 绕过限流与白名单。
LT_TRUSTED_PROXIES=127.0.0.1,::1

# ---------- 控制台前端产物 ----------
LT_USER_WEB_DIR=./web/user/dist
LT_ADMIN_WEB_DIR=./web/admin/dist

# ---------- 客户端分发 ----------
# 存放对外分发的客户端安装包目录，用户控制台会自动列出该目录下的文件
LT_CLIENT_DIST_DIR=./data/clients

# ---------- 流量统计 ----------
# 从 frps 拉取流量统计的间隔（秒）
LT_TRAFFIC_POLL_INTERVAL=30
