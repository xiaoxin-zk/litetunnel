# ============================================================
#  frps 服务端配置模板
#  由 deploy/scripts/render 脚本从 .env 渲染生成 frps.toml。
#  请勿直接编辑 frps.toml（已被 .gitignore 忽略）。
# ============================================================

bindAddr = "0.0.0.0"
bindPort = ${LT_GATEWAY_PORT}

# KCP/QUIC 使用同一 UDP 端口，游戏联机走 KCP 可显著降低延迟
kcpBindPort = ${LT_KCP_PORT}

# ---------- HTTP/HTTPS 隧道入口 ----------
#
# vhostHTTPPort 是网站隧道的 HTTP 入口，监听在所有网卡上：
#   · Caddy 通过 127.0.0.1:${LT_VHOST_HTTP_PORT} 转发进来（泛域名证书在 443 终止）；
#   · 同时它也是可以直接对外访问的明文入口，需要在安全组里放行。
#
# 说明：frp 的 vhost 监听地址**只能**由 proxyBindAddr 决定，而 proxyBindAddr
# 同时用于绑定隧道端口池（frp v0.71 的 server/ports 用它 net.Listen 每一个远程
# 端口）。把它设成 127.0.0.1 会让所有 TCP/UDP 隧道都无法从公网访问，因此这里
# 保持默认的 0.0.0.0。
#
# 代价是外部可以用 Host 头直接访问隧道站点（不经过 Caddy，也就没有 TLS）。
# 这是该入口的设计行为，默认对公网开放。
#
# 如果不需要「IP:${LT_VHOST_HTTP_PORT}」直连、只想让 Caddy 使用它，可以只封
# 非回环来源（必须带 ! -i lo，否则本机转发也会被挡住）：
#   iptables -I INPUT ! -i lo -p tcp --dport ${LT_VHOST_HTTP_PORT} -j DROP
#   nft add rule inet filter input iifname != "lo" tcp dport ${LT_VHOST_HTTP_PORT} drop
#
# 另外：HTTP 隧道必须有域名（subDomainHost），没有域名时请把本地网站映射成
# TCP 隧道，用 http://服务器IP:<分配的远程端口> 访问，那条路径不经过这个入口。
vhostHTTPPort = ${LT_VHOST_HTTP_PORT}
#
# vhostHTTPSPort：只在端到端模式（LT_HTTPS_TUNNEL_MODE=e2e）下需要，此时它
# 直接对公网提供：frps 按 SNI 把**原始 TLS 连接**转给 frpc，证书由本地网站
# 自己持有。边缘模式下整段不渲染——端口不会监听，也就没有可绕过的入口。
# @if LT_HTTPS_E2E_PORT
vhostHTTPSPort = ${LT_VHOST_HTTPS_PORT}
# 当前为端到端模式：请务必放行 ${LT_HTTPS_E2E_PORT}/TCP，
# 并且让 HTTPS 隧道用这个端口访问（443 由 Caddy 接管，会返回平台自己的证书）。
# @endif

# 强制 TLS：拒绝任何明文连接
transport.tls.force = true
transport.maxPoolCount = 5

# UDP 包大小需与客户端一致，影响 udp/sudp 代理
udpPacketSize = 1500

# 客户端接入认证（全局 token，与每用户凭据共同构成两层校验）
auth.method = "token"
auth.token = "${LT_FRPS_TOKEN}"

# 端口池：用户只能使用该范围内的端口，防止占用特权端口或任意端口
allowPorts = [ { start = ${LT_PORT_RANGE_START}, end = ${LT_PORT_RANGE_END} } ]
maxPortsPerClient = ${LT_MAX_PORTS_PER_USER}

# HTTP 隧道泛域名（留空表示不启用 HTTP 隧道）
subDomainHost = "${LT_TUNNEL_DOMAIN}"

log.to = "./frps.log"
log.level = "info"
log.maxDays = 7
log.disablePrintColor = true

# 管理接口：只监听回环，控制面通过它采集流量与代理状态
webServer.addr = "127.0.0.1"
webServer.port = ${LT_FRPS_API_PORT}
webServer.user = "${LT_FRPS_API_USER}"
webServer.password = "${LT_FRPS_API_PASSWORD}"

enablePrometheus = true

# ============================================================
#  服务端插件：把鉴权、隧道审批、配额断流的决策权交给控制面
#  ops 全部启用，缺一不可：
#    Login        校验每用户独立凭据
#    NewProxy     校验隧道归属/协议/端口，并强制下发限速
#    CloseProxy   记录关闭事件
#    Ping         刷新会话心跳
#    NewWorkConn  工作连接建立
#    NewUserConn  超额时实时拒绝新建用户连接
# ============================================================
[[httpPlugins]]
name = "litetunnel-panel"
# 控制面已合并为单一入口，插件回调走用户侧端口（仅回环可达）
addr = "127.0.0.1:${LT_USER_PORT}"
path = "/api/frps/plugin"
ops = ["Login", "NewProxy", "CloseProxy", "Ping", "NewWorkConn", "NewUserConn"]
